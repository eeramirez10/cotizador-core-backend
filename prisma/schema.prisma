generator client {
  provider = "prisma-client"
  output   = "../src/infrastructure/database/generated"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  SELLER
  MANAGER
  PURCHASING
}

enum CustomerProfileStatus {
  PROSPECT
  FISCAL_COMPLETED
}

enum CustomerSource {
  ERP
  LOCAL
}

enum ProductSource {
  ERP
  LOCAL_TEMP
}

enum ProductProcurementStatus {
  PENDING_REVIEW
  QUOTING
  COSTED
  PENDING_ERP
  ERP_LINKED
  REJECTED
}

enum SupplierSource {
  ERP
  LOCAL
}

enum SupplierScope {
  NATIONAL
  INTERNATIONAL
}

enum SupplierStatus {
  PROSPECT
  PENDING_ERP
  ERP_SYNCED
}

enum PurchaseOfferSource {
  SELLER
  PURCHASING
}

enum PurchaseRequisitionStatus {
  DRAFT
  SUBMITTED
  IN_PROGRESS
  PARTIALLY_QUOTED
  COST_REVIEW
  READY_FOR_ORDER
  COMPLETED
  CANCELLED
}

enum PurchaseRequisitionItemStatus {
  PENDING
  QUOTING
  OFFER_SELECTED
  PENDING_ERP_CODE
  READY
  CANCELLED
}

enum PurchaseItemSource {
  ERP_NO_STOCK
  LOCAL_NEW
}

enum PurchaseCostSource {
  ERP_COST
  SELLER_SUPPLIER_QUOTE
  ESTIMATED
}

enum FileAssetStatus {
  READY
  DELETED
}

enum QuoteAttachmentCategory {
  SOURCE_DOCUMENT
  SELLER_SUPPLIER_QUOTE
}

enum Currency {
  MXN
  USD
}

enum QuoteStatus {
  DRAFT
  PENDING
  PENDING_APPROVAL
  CHANGES_REQUESTED
  QUOTED
  APPROVED
  REJECTED
  CANCELLED
  SUPERSEDED
}

enum QuoteCatalogType {
  VALIDITY_DAYS
  PAYMENT_TERMS
  COMMERCIAL_CONDITIONS
  DELIVERY_TIME
  REVISION_REASON
  REJECTION_REASON
  CANCELLATION_REASON
  APPROVAL_RETURN_REASON
  PURCHASE_BRAND
  ORIGIN_RESTRICTION
  DELIVERY_STATE
}

enum QuoteOrigin {
  MANUAL
  FILE_UPLOAD
  TEXT_INPUT
}

enum QuoteCaptureMethod {
  SYSTEM
  EXCEL_IMPORT
}

enum QuoteSourceChannel {
  UNSPECIFIED
  EMAIL
  PHONE
  WHATSAPP
  AI_ASSISTANT
  IN_PERSON
  OTHER
}

enum QuoteDeliveryStatus {
  NOT_SENT
  SENT
}

enum QuoteDeliveryChannel {
  WHATSAPP
  EMAIL
}

enum QuoteDeliveryAttemptStatus {
  SENT
  FAILED
}

enum OrderGenerationStatus {
  NOT_GENERATED
  GENERATED
}

enum ErpTransferStatus {
  PENDING_UPLOAD
  UPLOADING
  UPLOADED
  FAILED
}

model Branch {
  id             String   @id @default(uuid()) @db.Uuid
  code           String   @unique @db.VarChar(10)
  name           String   @db.VarChar(120)
  address        String?  @db.VarChar(255)
  street         String?  @db.VarChar(120)
  exteriorNumber String?  @map("exterior_number") @db.VarChar(40)
  interiorNumber String?  @map("interior_number") @db.VarChar(40)
  neighborhood   String?  @db.VarChar(120)
  city           String?  @db.VarChar(120)
  municipality   String?  @db.VarChar(120)
  state          String?  @db.VarChar(120)
  postalCode     String?  @map("postal_code") @db.VarChar(10)
  country        String?  @default("México") @db.VarChar(80)
  email          String?  @db.VarChar(160)
  phone          String?  @db.VarChar(40)
  secondaryPhone String?  @map("secondary_phone") @db.VarChar(40)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  users                User[]
  quotes               Quote[]
  products             Product[]
  quoteCatalogOptions  QuoteCatalogOption[]
  purchaseRequisitions PurchaseRequisition[]

  @@map("branches")
}

model QuoteCatalogOption {
  id              String           @id @default(uuid()) @db.Uuid
  type            QuoteCatalogType
  code            String           @db.VarChar(80)
  label           String           @db.VarChar(260)
  value           String?          @db.Text
  numericValue    Int?             @map("numeric_value")
  requiresComment Boolean          @default(false) @map("requires_comment")
  sortOrder       Int              @default(0) @map("sort_order")
  isActive        Boolean          @default(true) @map("is_active")
  branchId        String?          @map("branch_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  branch Branch? @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([type, code, branchId])
  @@index([type, isActive])
  @@index([branchId])
  @@map("quote_catalog_options")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  firstName    String   @map("first_name") @db.VarChar(120)
  lastName     String   @map("last_name") @db.VarChar(120)
  username     String   @unique @db.VarChar(80)
  email        String   @unique @db.VarChar(160)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         UserRole
  isActive     Boolean  @default(true) @map("is_active")
  phone        String?  @db.VarChar(40)
  branchId     String   @map("branch_id") @db.Uuid
  erpUserCode  String?  @unique @map("erp_user_code") @db.VarChar(80)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  createdCustomers            Customer[]                     @relation("CustomerCreatedBy")
  updatedCustomers            Customer[]                     @relation("CustomerUpdatedBy")
  createdProducts             Product[]                      @relation("ProductCreatedBy")
  updatedProducts             Product[]                      @relation("ProductUpdatedBy")
  procurementProducts         Product[]                      @relation("ProductProcurementUpdatedBy")
  createdProcurementOffers    LocalProductProcurementOffer[] @relation("ProcurementOfferCreatedBy")
  updatedProcurementOffers    LocalProductProcurementOffer[] @relation("ProcurementOfferUpdatedBy")
  createdQuotes               Quote[]                        @relation("QuoteCreatedBy")
  updatedQuotes               Quote[]                        @relation("QuoteUpdatedBy")
  rejectedQuotes              Quote[]                        @relation("QuoteRejectedBy")
  cancelledQuotes             Quote[]                        @relation("QuoteCancelledBy")
  archivedQuotes              Quote[]                        @relation("QuoteArchivedBy")
  providedQuotes              Quote[]                        @relation("QuoteProvidedBy")
  providerAssignments         Quote[]                        @relation("QuoteProviderAssignedBy")
  erpRegisteredQuotes         Quote[]                        @relation("QuoteErpRegisteredBy")
  quoteDeliveryAttempts       QuoteDeliveryAttempt[]         @relation("QuoteDeliveryAttemptSentBy")
  quoteOrderExports           QuoteOrderExport[]             @relation("QuoteOrderExportGeneratedBy")
  quoteEvents                 QuoteEvent[]                   @relation("QuoteEventActor")
  refreshTokens               RefreshToken[]
  auditLogs                   AuditLog[]                     @relation("AuditLogActor")
  createdSuppliers            Supplier[]                     @relation("SupplierCreatedBy")
  updatedSuppliers            Supplier[]                     @relation("SupplierUpdatedBy")
  requestedRequisitions       PurchaseRequisition[]          @relation("PurchaseRequisitionRequestedBy")
  assignedRequisitions        PurchaseRequisition[]          @relation("PurchaseRequisitionAssignedBuyer")
  approvedCostRequisitions    PurchaseRequisition[]          @relation("PurchaseRequisitionCostApprovedBy")
  erpLinkedRequisitionItems   PurchaseRequisitionItem[]      @relation("PurchaseRequisitionItemErpLinkedBy")
  createdSupplierOffers       PurchaseSupplierOffer[]        @relation("PurchaseSupplierOfferCreatedBy")
  updatedSupplierOffers       PurchaseSupplierOffer[]        @relation("PurchaseSupplierOfferUpdatedBy")
  createdSupplierQuotes       PurchaseSupplierQuote[]        @relation("PurchaseSupplierQuoteCreatedBy")
  updatedSupplierQuotes       PurchaseSupplierQuote[]        @relation("PurchaseSupplierQuoteUpdatedBy")
  uploadedFileAssets          FileAsset[]                    @relation("FileAssetUploadedBy")
  editedQuoteItemDescriptions QuoteItem[]                    @relation("QuoteItemCustomerDescriptionEditedBy")

  @@index([branchId])
  @@map("users")
}

model Customer {
  id                String                @id @default(uuid()) @db.Uuid
  source            CustomerSource        @default(LOCAL)
  externalId        String?               @map("external_id") @db.VarChar(120)
  externalSystem    String?               @map("external_system") @db.VarChar(80)
  code              String?               @db.VarChar(80)
  firstName         String                @map("first_name") @db.VarChar(120)
  lastName          String                @map("last_name") @db.VarChar(120)
  displayName       String                @map("display_name") @db.VarChar(260)
  legalName         String?               @map("legal_name") @db.VarChar(260)
  email             String?               @db.VarChar(160)
  phone             String?               @db.VarChar(40)
  whatsapp          String                @db.VarChar(40)
  taxId             String?               @map("tax_id") @db.VarChar(60)
  taxRegime         String?               @map("tax_regime") @db.VarChar(120)
  billingStreet     String?               @map("billing_street") @db.VarChar(255)
  billingCity       String?               @map("billing_city") @db.VarChar(120)
  billingState      String?               @map("billing_state") @db.VarChar(120)
  billingPostalCode String?               @map("billing_postal_code") @db.VarChar(20)
  billingCountry    String?               @map("billing_country") @db.VarChar(80)
  profileStatus     CustomerProfileStatus @default(PROSPECT) @map("profile_status")
  isActive          Boolean               @default(true) @map("is_active")
  notes             String?               @db.Text
  createdByUserId   String?               @map("created_by_user_id") @db.Uuid
  updatedByUserId   String?               @map("updated_by_user_id") @db.Uuid
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  createdByUser User? @relation("CustomerCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedByUser User? @relation("CustomerUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  contacts CustomerContact[]
  quotes   Quote[]

  @@index([externalId])
  @@index([code])
  @@index([displayName])
  @@index([whatsapp])
  @@map("customers")
}

model CustomerContact {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  name       String   @db.VarChar(160)
  jobTitle   String?  @map("job_title") @db.VarChar(120)
  email      String?  @db.VarChar(160)
  phone      String?  @db.VarChar(40)
  mobile     String?  @db.VarChar(40)
  isPrimary  Boolean  @default(false) @map("is_primary")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_contacts")
}

model Product {
  id                         String                   @id @default(uuid()) @db.Uuid
  source                     ProductSource            @default(LOCAL_TEMP)
  externalId                 String?                  @map("external_id") @db.VarChar(120)
  externalSystem             String?                  @map("external_system") @db.VarChar(80)
  code                       String?                  @db.VarChar(80)
  ean                        String?                  @db.VarChar(120)
  description                String                   @db.VarChar(500)
  canonicalDescription       String                   @default("") @map("canonical_description") @db.VarChar(500)
  unit                       String                   @db.VarChar(30)
  currency                   Currency                 @default(USD)
  averageCost                Decimal?                 @map("average_cost") @db.Decimal(14, 4)
  lastCost                   Decimal?                 @map("last_cost") @db.Decimal(14, 4)
  stock                      Decimal?                 @db.Decimal(14, 4)
  branchId                   String?                  @map("branch_id") @db.Uuid
  isActive                   Boolean                  @default(true) @map("is_active")
  createdByUserId            String?                  @map("created_by_user_id") @db.Uuid
  updatedByUserId            String?                  @map("updated_by_user_id") @db.Uuid
  procurementStatus          ProductProcurementStatus @default(PENDING_REVIEW) @map("procurement_status")
  procurementNotes           String?                  @map("procurement_notes") @db.Text
  selectedProcurementOfferId String?                  @unique @map("selected_procurement_offer_id") @db.Uuid
  procurementUpdatedAt       DateTime?                @map("procurement_updated_at")
  procurementUpdatedByUserId String?                  @map("procurement_updated_by_user_id") @db.Uuid
  createdAt                  DateTime                 @default(now()) @map("created_at")
  updatedAt                  DateTime                 @updatedAt @map("updated_at")

  branch                   Branch?                        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  createdByUser            User?                          @relation("ProductCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedByUser            User?                          @relation("ProductUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  procurementUpdatedByUser User?                          @relation("ProductProcurementUpdatedBy", fields: [procurementUpdatedByUserId], references: [id], onDelete: SetNull)
  procurementOffers        LocalProductProcurementOffer[] @relation("LocalProductProcurementOffers")
  selectedProcurementOffer LocalProductProcurementOffer?  @relation("SelectedLocalProductProcurementOffer", fields: [selectedProcurementOfferId], references: [id], onDelete: SetNull)

  quoteItems               QuoteItem[]
  purchaseRequisitionItems PurchaseRequisitionItem[]

  @@index([code])
  @@index([ean])
  @@index([description])
  @@index([source, isActive, canonicalDescription, unit])
  @@index([branchId])
  @@index([procurementStatus])
  @@index([procurementUpdatedByUserId])
  @@map("products")
}

model LocalProductProcurementOffer {
  id              String    @id @default(uuid()) @db.Uuid
  productId       String    @map("product_id") @db.Uuid
  supplierName    String    @map("supplier_name") @db.VarChar(220)
  contactName     String?   @map("contact_name") @db.VarChar(160)
  email           String?   @db.VarChar(160)
  phone           String?   @db.VarChar(40)
  unitCost        Decimal   @map("unit_cost") @db.Decimal(14, 4)
  currency        Currency
  minimumQty      Decimal?  @map("minimum_qty") @db.Decimal(14, 4)
  deliveryTime    String?   @map("delivery_time") @db.VarChar(120)
  validUntil      DateTime? @map("valid_until") @db.Date
  notes           String?   @db.Text
  isSelected      Boolean   @default(false) @map("is_selected")
  isActive        Boolean   @default(true) @map("is_active")
  createdByUserId String    @map("created_by_user_id") @db.Uuid
  updatedByUserId String?   @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  product            Product  @relation("LocalProductProcurementOffers", fields: [productId], references: [id], onDelete: Cascade)
  selectedForProduct Product? @relation("SelectedLocalProductProcurementOffer")
  createdByUser      User     @relation("ProcurementOfferCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedByUser      User?    @relation("ProcurementOfferUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([productId, isActive])
  @@index([supplierName])
  @@index([createdByUserId])
  @@map("local_product_procurement_offers")
}

model Quote {
  id                           String                @id @default(uuid()) @db.Uuid
  quoteNumber                  String                @unique @map("quote_number") @db.VarChar(40)
  clientDraftId                String?               @map("client_draft_id") @db.VarChar(80)
  status                       QuoteStatus           @default(DRAFT)
  deliveryStatus               QuoteDeliveryStatus   @default(NOT_SENT) @map("delivery_status")
  firstSentAt                  DateTime?             @map("first_sent_at")
  orderStatus                  OrderGenerationStatus @default(NOT_GENERATED) @map("order_status")
  orderGeneratedAt             DateTime?             @map("order_generated_at")
  orderReference               String?               @unique @map("order_reference") @db.VarChar(80)
  erpQuoteNumber               String?               @unique @map("erp_quote_number") @db.VarChar(80)
  erpQuoteRegisteredAt         DateTime?             @map("erp_quote_registered_at")
  erpQuoteRegisteredByUserId   String?               @map("erp_quote_registered_by_user_id") @db.Uuid
  origin                       QuoteOrigin           @default(MANUAL)
  captureMethod                QuoteCaptureMethod    @default(SYSTEM) @map("capture_method")
  originalQuoteDate            DateTime?             @map("original_quote_date") @db.Date
  sourceChannel                QuoteSourceChannel    @default(UNSPECIFIED) @map("source_channel")
  currency                     Currency
  exchangeRate                 Decimal               @map("exchange_rate") @db.Decimal(14, 6)
  exchangeRateDate             DateTime              @map("exchange_rate_date") @db.Date
  taxRate                      Decimal               @map("tax_rate") @db.Decimal(8, 6)
  subtotal                     Decimal               @db.Decimal(14, 4)
  tax                          Decimal               @db.Decimal(14, 4)
  total                        Decimal               @db.Decimal(14, 4)
  deliveryPlace                String?               @map("delivery_place") @db.VarChar(255)
  paymentTerms                 String                @default("CONTADO") @map("payment_terms") @db.VarChar(220)
  commercialConditions         String?               @map("commercial_conditions") @db.Text
  validityDays                 Int                   @default(10) @map("validity_days")
  validUntil                   DateTime              @map("valid_until") @db.Date
  branchId                     String                @map("branch_id") @db.Uuid
  customerId                   String                @map("customer_id") @db.Uuid
  createdByUserId              String                @map("created_by_user_id") @db.Uuid
  updatedByUserId              String?               @map("updated_by_user_id") @db.Uuid
  providedByUserId             String?               @map("provided_by_user_id") @db.Uuid
  providedByNameSnapshot       String?               @map("provided_by_name_snapshot") @db.VarChar(260)
  providedByBranchNameSnapshot String?               @map("provided_by_branch_name_snapshot") @db.VarChar(120)
  providedAt                   DateTime?             @map("provided_at")
  providedByAssignedByUserId   String?               @map("provided_by_assigned_by_user_id") @db.Uuid
  rejectionReason              String?               @map("rejection_reason") @db.VarChar(80)
  rejectionComment             String?               @map("rejection_comment") @db.Text
  rejectedAt                   DateTime?             @map("rejected_at")
  rejectedByUserId             String?               @map("rejected_by_user_id") @db.Uuid
  cancellationReason           String?               @map("cancellation_reason") @db.VarChar(80)
  cancellationComment          String?               @map("cancellation_comment") @db.Text
  cancelledAt                  DateTime?             @map("cancelled_at")
  cancelledByUserId            String?               @map("cancelled_by_user_id") @db.Uuid
  approvalReturnReason         String?               @map("approval_return_reason") @db.VarChar(80)
  approvalReturnComment        String?               @map("approval_return_comment") @db.Text
  rootQuoteId                  String?               @map("root_quote_id") @db.Uuid
  previousVersionId            String?               @map("previous_version_id") @db.Uuid
  supersededByQuoteId          String?               @unique @map("superseded_by_quote_id") @db.Uuid
  revisionNumber               Int                   @default(0) @map("revision_number")
  revisionReason               String?               @map("revision_reason") @db.VarChar(80)
  revisionComment              String?               @map("revision_comment") @db.Text
  supersededAt                 DateTime?             @map("superseded_at")
  archivedAt                   DateTime?             @map("archived_at")
  archivedByUserId             String?               @map("archived_by_user_id") @db.Uuid
  archiveReason                String?               @map("archive_reason") @db.Text
  notes                        String?               @db.Text
  createdAt                    DateTime              @default(now()) @map("created_at")
  updatedAt                    DateTime              @updatedAt @map("updated_at")

  branch                   Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customer                 Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdByUser            User     @relation("QuoteCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedByUser            User?    @relation("QuoteUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  providedByUser           User?    @relation("QuoteProvidedBy", fields: [providedByUserId], references: [id], onDelete: SetNull)
  providedByAssignedByUser User?    @relation("QuoteProviderAssignedBy", fields: [providedByAssignedByUserId], references: [id], onDelete: SetNull)
  rejectedByUser           User?    @relation("QuoteRejectedBy", fields: [rejectedByUserId], references: [id], onDelete: SetNull)
  cancelledByUser          User?    @relation("QuoteCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: SetNull)
  archivedByUser           User?    @relation("QuoteArchivedBy", fields: [archivedByUserId], references: [id], onDelete: SetNull)
  erpQuoteRegisteredByUser User?    @relation("QuoteErpRegisteredBy", fields: [erpQuoteRegisteredByUserId], references: [id], onDelete: SetNull)
  rootQuote                Quote?   @relation("QuoteRevisionRoot", fields: [rootQuoteId], references: [id], onDelete: Restrict)
  revisions                Quote[]  @relation("QuoteRevisionRoot")
  previousVersion          Quote?   @relation("QuotePreviousVersion", fields: [previousVersionId], references: [id], onDelete: Restrict)
  nextVersions             Quote[]  @relation("QuotePreviousVersion")
  supersededByQuote        Quote?   @relation("QuoteSupersededBy", fields: [supersededByQuoteId], references: [id], onDelete: SetNull)
  supersedesQuote          Quote?   @relation("QuoteSupersededBy")

  items               QuoteItem[]
  deliveryAttempts    QuoteDeliveryAttempt[]
  orderExports        QuoteOrderExport[]
  events              QuoteEvent[]
  purchaseRequisition PurchaseRequisition?
  attachments         QuoteAttachment[]

  @@unique([createdByUserId, clientDraftId])
  @@unique([rootQuoteId, revisionNumber])
  @@index([erpQuoteRegisteredByUserId])
  @@index([status])
  @@index([captureMethod])
  @@index([deliveryStatus])
  @@index([orderStatus])
  @@index([branchId])
  @@index([customerId])
  @@index([createdByUserId])
  @@index([providedByUserId])
  @@index([rejectionReason])
  @@index([rejectedByUserId])
  @@index([cancellationReason])
  @@index([cancelledByUserId])
  @@index([approvalReturnReason])
  @@index([archivedAt])
  @@index([archivedByUserId])
  @@index([rootQuoteId])
  @@index([previousVersionId])
  @@map("quotes")
}

model QuoteItem {
  id                                String    @id @default(uuid()) @db.Uuid
  quoteId                           String    @map("quote_id") @db.Uuid
  clientItemId                      String?   @map("client_item_id") @db.VarChar(80)
  productId                         String?   @map("product_id") @db.Uuid
  externalProductCode               String?   @map("external_product_code") @db.VarChar(80)
  ean                               String?   @db.VarChar(120)
  customerDescription               String?   @map("customer_description") @db.VarChar(500)
  customerDescriptionOriginal       String?   @map("customer_description_original") @db.VarChar(500)
  customerDescriptionEditedAt       DateTime? @map("customer_description_edited_at")
  customerDescriptionEditedByUserId String?   @map("customer_description_edited_by_user_id") @db.Uuid
  customerUnit                      String?   @map("customer_unit") @db.VarChar(30)
  erpDescription                    String?   @map("erp_description") @db.VarChar(500)
  unit                              String    @db.VarChar(30)
  qty                               Decimal   @db.Decimal(14, 4)
  stock                             Decimal?  @db.Decimal(14, 4)
  deliveryTime                      String?   @map("delivery_time") @db.VarChar(80)
  itemComment                       String?   @map("item_comment") @db.VarChar(500)
  sellerSupplierId                  String?   @map("seller_supplier_id") @db.Uuid
  sellerSupplierNameSnapshot        String?   @map("seller_supplier_name_snapshot") @db.VarChar(220)
  sellerQuotedUnitCost              Decimal?  @map("seller_quoted_unit_cost") @db.Decimal(14, 4)
  sellerQuotedCurrency              Currency? @map("seller_quoted_currency")
  sellerQuotedExchangeRate          Decimal?  @map("seller_quoted_exchange_rate") @db.Decimal(14, 6)
  sellerQuotedBrand                 String?   @map("seller_quoted_brand") @db.VarChar(160)
  sellerSupplierDescription         String?   @map("seller_supplier_description") @db.VarChar(500)
  sellerSupplierOrigin              String?   @map("seller_supplier_origin") @db.VarChar(120)
  sellerSupplierQuoteValidUntil     DateTime? @map("seller_supplier_quote_valid_until") @db.Date
  sellerSupplierQuoteReference      String?   @map("seller_supplier_quote_reference") @db.VarChar(160)
  sellerSupplierQuoteNotes          String?   @map("seller_supplier_quote_notes") @db.Text
  sellerOriginRestrictions          String[]  @default([]) @map("seller_origin_restrictions")
  sellerDeliveryState               String?   @map("seller_delivery_state") @db.VarChar(120)
  sellerSupplierDeliveryTime        String?   @map("seller_supplier_delivery_time") @db.VarChar(120)
  purchaseStandard                  String?   @map("purchase_standard") @db.VarChar(120)
  purchaseDiameter                  String?   @map("purchase_diameter") @db.VarChar(120)
  purchaseThickness                 String?   @map("purchase_thickness") @db.VarChar(120)
  purchaseBore                      String?   @map("purchase_bore") @db.VarChar(120)
  technicalFamily                   String?   @map("technical_family") @db.VarChar(60)
  technicalAttributes               Json?     @map("technical_attributes")
  cost                              Decimal   @db.Decimal(14, 4)
  costCurrency                      Currency  @map("cost_currency")
  marginPct                         Decimal   @map("margin_pct") @db.Decimal(10, 4)
  sourceCurrency                    Currency? @map("source_currency")
  sourceUnitPrice                   Decimal?  @map("source_unit_price") @db.Decimal(14, 4)
  sourceSubtotal                    Decimal?  @map("source_subtotal") @db.Decimal(14, 4)
  unitPrice                         Decimal   @map("unit_price") @db.Decimal(14, 4)
  subtotal                          Decimal   @db.Decimal(14, 4)
  sourceRequiresReview              Boolean   @default(false) @map("source_requires_review")
  requiresReview                    Boolean   @default(false) @map("requires_review")
  createdAt                         DateTime  @default(now()) @map("created_at")
  updatedAt                         DateTime  @updatedAt @map("updated_at")

  quote                           Quote                    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product                         Product?                 @relation(fields: [productId], references: [id], onDelete: SetNull)
  sellerSupplier                  Supplier?                @relation("QuoteItemSellerSupplier", fields: [sellerSupplierId], references: [id], onDelete: SetNull)
  customerDescriptionEditedByUser User?                    @relation("QuoteItemCustomerDescriptionEditedBy", fields: [customerDescriptionEditedByUserId], references: [id], onDelete: SetNull)
  purchaseRequisitionItem         PurchaseRequisitionItem?

  @@unique([quoteId, clientItemId])
  @@index([quoteId])
  @@index([productId])
  @@index([sellerSupplierId])
  @@index([customerDescriptionEditedByUserId])
  @@map("quote_items")
}

model Supplier {
  id              String         @id @default(uuid()) @db.Uuid
  erpCode         String?        @unique @map("erp_code") @db.VarChar(40)
  name            String         @db.VarChar(220)
  canonicalName   String         @map("canonical_name") @db.VarChar(220)
  status          SupplierStatus @default(PROSPECT)
  source          SupplierSource @default(LOCAL)
  scope           SupplierScope  @default(NATIONAL)
  taxId           String?        @map("tax_id") @db.VarChar(60)
  normalizedTaxId String?        @unique @map("normalized_tax_id") @db.VarChar(60)
  state           String?        @db.VarChar(120)
  creditTerms     String?        @map("credit_terms") @db.VarChar(120)
  currency        Currency?
  country         String?        @db.VarChar(100)
  contactName     String?        @map("contact_name") @db.VarChar(160)
  contactPosition String?        @map("contact_position") @db.VarChar(160)
  email           String?        @db.VarChar(160)
  normalizedEmail String?        @map("normalized_email") @db.VarChar(160)
  phone           String?        @db.VarChar(40)
  normalizedPhone String?        @map("normalized_phone") @db.VarChar(40)
  phoneExtension  String?        @map("phone_extension") @db.VarChar(30)
  mobile          String?        @db.VarChar(40)
  notes           String?        @db.Text
  erpSyncedAt     DateTime?      @map("erp_synced_at")
  isActive        Boolean        @default(true) @map("is_active")
  createdByUserId String         @map("created_by_user_id") @db.Uuid
  updatedByUserId String?        @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  createdBy              User                      @relation("SupplierCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy              User?                     @relation("SupplierUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  offers                 PurchaseSupplierOffer[]
  supplierQuotes         PurchaseSupplierQuote[]
  sellerQuotedItems      QuoteItem[]               @relation("QuoteItemSellerSupplier")
  sellerRequisitionItems PurchaseRequisitionItem[] @relation("RequisitionSellerSupplier")

  @@index([canonicalName])
  @@index([source, isActive])
  @@index([taxId])
  @@index([normalizedEmail])
  @@index([normalizedPhone])
  @@map("suppliers")
}

model PurchaseRequisition {
  id                   String                    @id @default(uuid()) @db.Uuid
  requisitionNumber    String                    @unique @map("requisition_number") @db.VarChar(40)
  quoteId              String                    @unique @map("quote_id") @db.Uuid
  branchId             String                    @map("branch_id") @db.Uuid
  requestedByUserId    String                    @map("requested_by_user_id") @db.Uuid
  assignedBuyerUserId  String?                   @map("assigned_buyer_user_id") @db.Uuid
  costApprovedByUserId String?                   @map("cost_approved_by_user_id") @db.Uuid
  status               PurchaseRequisitionStatus @default(DRAFT)
  deliveryState        String?                   @map("delivery_state") @db.VarChar(120)
  deliveryPlace        String?                   @map("delivery_place") @db.VarChar(255)
  notes                String?                   @db.Text
  submittedAt          DateTime?                 @map("submitted_at")
  completedAt          DateTime?                 @map("completed_at")
  costApprovedAt       DateTime?                 @map("cost_approved_at")
  createdAt            DateTime                  @default(now()) @map("created_at")
  updatedAt            DateTime                  @updatedAt @map("updated_at")

  quote          Quote                     @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  branch         Branch                    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  requestedBy    User                      @relation("PurchaseRequisitionRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  assignedBuyer  User?                     @relation("PurchaseRequisitionAssignedBuyer", fields: [assignedBuyerUserId], references: [id], onDelete: SetNull)
  costApprovedBy User?                     @relation("PurchaseRequisitionCostApprovedBy", fields: [costApprovedByUserId], references: [id], onDelete: SetNull)
  items          PurchaseRequisitionItem[]
  supplierQuotes PurchaseSupplierQuote[]

  @@index([status, createdAt])
  @@index([branchId])
  @@index([requestedByUserId])
  @@index([assignedBuyerUserId])
  @@index([costApprovedByUserId])
  @@map("purchase_requisitions")
}

model PurchaseRequisitionItem {
  id                 String                        @id @default(uuid()) @db.Uuid
  requisitionId      String                        @map("requisition_id") @db.Uuid
  quoteItemId        String                        @unique @map("quote_item_id") @db.Uuid
  position           Int
  productId          String?                       @map("product_id") @db.Uuid
  source             PurchaseItemSource
  erpCode            String?                       @map("erp_code") @db.VarChar(80)
  erpEan             String?                       @map("erp_ean") @db.VarChar(120)
  erpLinkedAt        DateTime?                     @map("erp_linked_at")
  erpLinkedByUserId  String?                       @map("erp_linked_by_user_id") @db.Uuid
  qty                Decimal                       @db.Decimal(14, 4)
  unit               String                        @db.VarChar(30)
  description        String                        @db.VarChar(500)
  standard           String?                       @db.VarChar(120)
  diameter           String?                       @db.VarChar(120)
  thickness          String?                       @db.VarChar(120)
  bore               String?                       @db.VarChar(120)
  technicalFamily    String?                       @map("technical_family") @db.VarChar(60)
  technicalAttributes Json?                        @map("technical_attributes")
  sellerUnitCost     Decimal                       @map("seller_unit_cost") @db.Decimal(14, 4)
  sellerCurrency     Currency                      @map("seller_currency")
  sellerExchangeRate Decimal                       @map("seller_exchange_rate") @db.Decimal(14, 6)
  sellerCostSource   PurchaseCostSource            @map("seller_cost_source")
  sellerSupplierId   String?                       @map("seller_supplier_id") @db.Uuid
  sellerSupplierName String?                       @map("seller_supplier_name") @db.VarChar(220)
  sellerBrand        String?                       @map("seller_brand") @db.VarChar(160)
  originRestrictions String[]                      @default([]) @map("origin_restrictions")
  sellerDeliveryTime String?                       @map("seller_delivery_time") @db.VarChar(120)
  deliveryPlace      String?                       @map("delivery_place") @db.VarChar(255)
  status             PurchaseRequisitionItemStatus @default(PENDING)
  selectedOfferId    String?                       @unique @map("selected_offer_id") @db.Uuid
  createdAt          DateTime                      @default(now()) @map("created_at")
  updatedAt          DateTime                      @updatedAt @map("updated_at")

  requisition    PurchaseRequisition     @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  quoteItem      QuoteItem               @relation(fields: [quoteItemId], references: [id], onDelete: Restrict)
  product        Product?                @relation(fields: [productId], references: [id], onDelete: SetNull)
  erpLinkedBy    User?                   @relation("PurchaseRequisitionItemErpLinkedBy", fields: [erpLinkedByUserId], references: [id], onDelete: SetNull)
  sellerSupplier Supplier?               @relation("RequisitionSellerSupplier", fields: [sellerSupplierId], references: [id], onDelete: SetNull)
  offers         PurchaseSupplierOffer[] @relation("PurchaseRequisitionItemOffers")
  selectedOffer  PurchaseSupplierOffer?  @relation("SelectedPurchaseSupplierOffer", fields: [selectedOfferId], references: [id], onDelete: SetNull)

  @@unique([requisitionId, position])
  @@index([requisitionId, status])
  @@index([productId])
  @@index([sellerSupplierId])
  @@index([erpLinkedByUserId])
  @@map("purchase_requisition_items")
}

model PurchaseSupplierOffer {
  id                String    @id @default(uuid()) @db.Uuid
  requisitionItemId String    @map("requisition_item_id") @db.Uuid
  supplierQuoteId   String?   @map("supplier_quote_id") @db.Uuid
  supplierId        String    @map("supplier_id") @db.Uuid
  source            PurchaseOfferSource @default(PURCHASING)
  supplierProductCode String? @map("supplier_product_code") @db.VarChar(120)
  alternateCodes    String[]  @default([]) @map("alternate_codes")
  supplierDescription String? @map("supplier_description") @db.VarChar(500)
  qty               Decimal   @db.Decimal(14, 4)
  unit              String?   @db.VarChar(30)
  listUnitPrice     Decimal?  @map("list_unit_price") @db.Decimal(14, 4)
  discountPct       Decimal?  @map("discount_pct") @db.Decimal(8, 4)
  unitCost          Decimal   @map("unit_cost") @db.Decimal(14, 4)
  currency          Currency
  exchangeRate      Decimal?  @map("exchange_rate") @db.Decimal(14, 6)
  subtotal          Decimal   @db.Decimal(14, 4)
  taxRate           Decimal   @default(0.16) @map("tax_rate") @db.Decimal(8, 6)
  tax               Decimal   @db.Decimal(14, 4)
  total             Decimal   @db.Decimal(14, 4)
  brand             String?   @db.VarChar(160)
  origin            String?   @db.VarChar(120)
  deliveryTime      String?   @map("delivery_time") @db.VarChar(120)
  availableDate     DateTime? @map("available_date") @db.Date
  minimumQty        Decimal?  @map("minimum_qty") @db.Decimal(14, 4)
  validUntil        DateTime? @map("valid_until") @db.Date
  quoteDate         DateTime  @default(now()) @map("quote_date") @db.Date
  sentAt            DateTime? @map("sent_at")
  externalReference String?   @map("external_reference") @db.VarChar(120)
  notes             String?   @db.Text
  isSelected        Boolean   @default(false) @map("is_selected")
  isActive          Boolean   @default(true) @map("is_active")
  createdByUserId   String    @map("created_by_user_id") @db.Uuid
  updatedByUserId   String?   @map("updated_by_user_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  requisitionItem PurchaseRequisitionItem   @relation("PurchaseRequisitionItemOffers", fields: [requisitionItemId], references: [id], onDelete: Cascade)
  supplierQuote   PurchaseSupplierQuote?    @relation(fields: [supplierQuoteId], references: [id], onDelete: SetNull)
  selectedForItem PurchaseRequisitionItem?  @relation("SelectedPurchaseSupplierOffer")
  supplier        Supplier                  @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy       User                      @relation("PurchaseSupplierOfferCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy       User?                     @relation("PurchaseSupplierOfferUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  attachments     PurchaseOfferAttachment[]

  @@index([requisitionItemId, isActive])
  @@index([supplierQuoteId])
  @@index([supplierId])
  @@index([createdByUserId])
  @@map("purchase_supplier_offers")
}

model PurchaseSupplierQuote {
  id               String              @id @default(uuid()) @db.Uuid
  requisitionId    String              @map("requisition_id") @db.Uuid
  supplierId       String              @map("supplier_id") @db.Uuid
  fileAssetId      String?             @map("file_asset_id") @db.Uuid
  source           PurchaseOfferSource @default(PURCHASING)
  reference        String?             @db.VarChar(120)
  quoteDate        DateTime            @default(now()) @map("quote_date") @db.Date
  validUntil       DateTime?           @map("valid_until") @db.Date
  currency         Currency
  exchangeRate     Decimal?            @map("exchange_rate") @db.Decimal(14, 6)
  paymentTerms     String?             @map("payment_terms") @db.VarChar(255)
  deliveryTerms    String?             @map("delivery_terms") @db.VarChar(255)
  subtotal         Decimal             @default(0) @db.Decimal(14, 4)
  discount         Decimal             @default(0) @db.Decimal(14, 4)
  freight          Decimal             @default(0) @db.Decimal(14, 4)
  otherCharges     Decimal             @default(0) @map("other_charges") @db.Decimal(14, 4)
  taxIncluded      Boolean             @default(false) @map("tax_included")
  taxRate          Decimal             @default(0.16) @map("tax_rate") @db.Decimal(8, 6)
  tax              Decimal             @default(0) @db.Decimal(14, 4)
  total            Decimal             @default(0) @db.Decimal(14, 4)
  notes            String?             @db.Text
  createdByUserId  String              @map("created_by_user_id") @db.Uuid
  updatedByUserId  String?             @map("updated_by_user_id") @db.Uuid
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  requisition PurchaseRequisition      @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  supplier    Supplier                 @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  fileAsset   FileAsset?               @relation(fields: [fileAssetId], references: [id], onDelete: SetNull)
  createdBy   User                     @relation("PurchaseSupplierQuoteCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy   User?                    @relation("PurchaseSupplierQuoteUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  offers      PurchaseSupplierOffer[]

  @@index([requisitionId, createdAt])
  @@index([supplierId])
  @@index([fileAssetId])
  @@map("purchase_supplier_quotes")
}

model FileAsset {
  id               String          @id @default(uuid()) @db.Uuid
  originalName     String          @map("original_name") @db.VarChar(255)
  storageKey       String          @unique @map("storage_key") @db.VarChar(500)
  mimeType         String          @map("mime_type") @db.VarChar(120)
  sizeBytes        Int             @map("size_bytes")
  checksumSha256   String          @map("checksum_sha256") @db.Char(64)
  status           FileAssetStatus @default(READY)
  uploadedByUserId String          @map("uploaded_by_user_id") @db.Uuid
  deletedAt        DateTime?       @map("deleted_at")
  createdAt        DateTime        @default(now()) @map("created_at")

  uploadedBy               User                      @relation("FileAssetUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  quoteAttachments         QuoteAttachment[]
  purchaseOfferAttachments PurchaseOfferAttachment[]
  purchaseSupplierQuotes   PurchaseSupplierQuote[]

  @@index([uploadedByUserId, createdAt])
  @@index([checksumSha256])
  @@map("file_assets")
}

model QuoteAttachment {
  id            String                  @id @default(uuid()) @db.Uuid
  fileAssetId   String                  @map("file_asset_id") @db.Uuid
  quoteId       String?                 @map("quote_id") @db.Uuid
  clientDraftId String                  @map("client_draft_id") @db.VarChar(80)
  clientItemId  String?                 @map("client_item_id") @db.VarChar(80)
  category      QuoteAttachmentCategory
  createdAt     DateTime                @default(now()) @map("created_at")

  fileAsset FileAsset @relation(fields: [fileAssetId], references: [id], onDelete: Cascade)
  quote     Quote?    @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@unique([fileAssetId, clientDraftId, clientItemId, category])
  @@index([clientDraftId, category])
  @@index([quoteId, category])
  @@index([clientItemId])
  @@map("quote_attachments")
}

model PurchaseOfferAttachment {
  id                      String   @id @default(uuid()) @db.Uuid
  fileAssetId             String   @map("file_asset_id") @db.Uuid
  purchaseSupplierOfferId String   @map("purchase_supplier_offer_id") @db.Uuid
  createdAt               DateTime @default(now()) @map("created_at")

  fileAsset             FileAsset             @relation(fields: [fileAssetId], references: [id], onDelete: Cascade)
  purchaseSupplierOffer PurchaseSupplierOffer @relation(fields: [purchaseSupplierOfferId], references: [id], onDelete: Cascade)

  @@unique([fileAssetId, purchaseSupplierOfferId])
  @@index([purchaseSupplierOfferId])
  @@map("purchase_offer_attachments")
}

model QuoteEvent {
  id          String      @id @default(uuid()) @db.Uuid
  quoteId     String      @map("quote_id") @db.Uuid
  status      QuoteStatus
  note        String?     @db.Text
  actorUserId String?     @map("actor_user_id") @db.Uuid
  createdAt   DateTime    @default(now()) @map("created_at")

  quote     Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  actorUser User? @relation("QuoteEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([quoteId])
  @@index([createdAt])
  @@map("quote_events")
}

model QuoteDeliveryAttempt {
  id                String                     @id @default(uuid()) @db.Uuid
  quoteId           String                     @map("quote_id") @db.Uuid
  channel           QuoteDeliveryChannel
  recipient         String                     @db.VarChar(180)
  status            QuoteDeliveryAttemptStatus
  providerMessageId String?                    @map("provider_message_id") @db.VarChar(160)
  errorMessage      String?                    @map("error_message") @db.Text
  sentByUserId      String?                    @map("sent_by_user_id") @db.Uuid
  sentAt            DateTime                   @map("sent_at")
  createdAt         DateTime                   @default(now()) @map("created_at")

  quote      Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  sentByUser User? @relation("QuoteDeliveryAttemptSentBy", fields: [sentByUserId], references: [id], onDelete: SetNull)

  @@index([quoteId])
  @@index([sentAt])
  @@map("quote_delivery_attempts")
}

model QuoteOrderExport {
  id                String            @id @default(uuid()) @db.Uuid
  quoteId           String            @map("quote_id") @db.Uuid
  orderReference    String            @map("order_reference") @db.VarChar(80)
  fileName          String            @map("file_name") @db.VarChar(180)
  transferStatus    ErpTransferStatus @default(PENDING_UPLOAD) @map("transfer_status")
  generatedByUserId String?           @map("generated_by_user_id") @db.Uuid
  generatedAt       DateTime          @map("generated_at")
  uploadedAt        DateTime?         @map("uploaded_at")
  remotePath        String?           @map("remote_path") @db.VarChar(260)
  lastError         String?           @map("last_error") @db.Text
  createdAt         DateTime          @default(now()) @map("created_at")

  quote           Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  generatedByUser User? @relation("QuoteOrderExportGeneratedBy", fields: [generatedByUserId], references: [id], onDelete: SetNull)

  @@index([quoteId])
  @@index([transferStatus])
  @@index([generatedAt])
  @@map("quote_order_exports")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  entityType  String   @map("entity_type") @db.VarChar(80)
  entityId    String   @map("entity_id") @db.VarChar(120)
  action      String   @db.VarChar(80)
  payload     Json?
  createdAt   DateTime @default(now()) @map("created_at")

  actorUser User? @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

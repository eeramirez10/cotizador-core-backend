# Production environment
PORT=4600
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME?schema=public"
SEED_ADMIN_PASSWORD=
ERP_OUTBOX_DIR="storage/erp-outbox"
FILE_STORAGE_ROOT="storage/attachments"
FILE_UPLOAD_MAX_MB=20
GPT_LOCAL_PRODUCTS_URL="http://localhost:4700/api/local-products-semantic"
GPT_LOCAL_PRODUCTS_API_KEY=replace-with-the-unified-platform-secret
GPT_LOCAL_PRODUCTS_TIMEOUT_MS=45000
AI_PLATFORM_BASE_URL="http://localhost:4700"
AI_PLATFORM_INTERNAL_API_KEY=replace-with-the-unified-platform-secret
AI_PLATFORM_TIMEOUT_MS=75000
AI_PLATFORM_MAX_UPLOAD_MB=15
LOCAL_PRODUCT_SEMANTIC_MIN_SCORE=0.72
ERP_API_URL="http://localhost:3500"
ERP_PRODUCTS_BASE_PATH="/api/erp/products"
ERP_SUPPLIERS_BASE_PATH="/api/erp/suppliers"
ERP_INTERNAL_API_KEY=
ERP_API_TIMEOUT_MS=15000
QUOTE_INTERNAL_APPROVAL_ENABLED=false
SELLER_EXCEL_IMPORT_ENABLED=true
WHATSAPP_INBOX_ENABLED=false

# Envio de cotizaciones por WhatsApp (Twilio)
PUBLIC_API_URL=http://localhost:4600
QUOTE_DOCUMENT_SIGNING_SECRET=replace-with-a-long-random-secret
QUOTE_DOCUMENT_URL_TTL_SECONDS=3600
TWILIO_WHATSAPP_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+5215555555555
TWILIO_WHATSAPP_QUOTE_CONTENT_SID=
TWILIO_WHATSAPP_QUOTE_MEDIA_VARIABLE=4
TWILIO_WHATSAPP_MANAGER_REPORT_CONTENT_SID=
TWILIO_WHATSAPP_MANAGER_REPORT_MEDIA_VARIABLE=3
WHATSAPP_ASSISTANT_ENABLED=false
WHATSAPP_ASSISTANT_INTERNAL_API_KEY=replace-with-shared-assistant-key
WHATSAPP_ASSISTANT_POLL_INTERVAL_MS=1000
WHATSAPP_ASSISTANT_MAX_ATTEMPTS=3
# Redis compartido por API y worker para eventos WebSocket del inbox.
# Desarrollo local: redis://127.0.0.1:6379. Docker Compose lo configura internamente.
REALTIME_REDIS_URL=redis://127.0.0.1:6379
REALTIME_REDIS_CHANNEL=cotizador:whatsapp:realtime
TWILIO_STATUS_CALLBACK_URL=
TWILIO_INCOMING_WEBHOOK_URL=
REQUISITION_INTERNAL_APPROVAL_ENABLED=false

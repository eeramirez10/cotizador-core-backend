LOCAL_PRODUCT_SEMANTIC_MIN_SCORE=0.72
ERP_API_URL="http://localhost:3500"
ERP_PRODUCTS_BASE_PATH="/api/erp/products"
ERP_API_TIMEOUT_MS=15000


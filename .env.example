# Production environment
PORT=4600
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME?schema=public"
SEED_DEFAULT_PASSWORD="Tuvansa123!"
ERP_OUTBOX_DIR="storage/erp-outbox"
GPT_LOCAL_PRODUCTS_URL="http://localhost:5500/api/local-products-semantic"
GPT_LOCAL_PRODUCTS_API_KEY=
GPT_LOCAL_PRODUCTS_TIMEOUT_MS=45000
LOCAL_PRODUCT_SEMANTIC_MIN_SCORE=0.72


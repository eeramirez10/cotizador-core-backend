# Copy to .env.staging. Do not reuse production database/JWT/signing secrets.
NODE_ENV=production
STAGING_DATABASE_URL=postgresql://STAGING_USER:STAGING_PASSWORD@STAGING_NEON_HOST/neondb?sslmode=require
STAGING_DATABASE_HOST=STAGING_NEON_HOST
PRODUCTION_DATABASE_HOST=ep-cold-queen-aiakczbm.c-4.us-east-1.aws.neon.tech
JWT_SEED=replace-with-staging-jwt-secret
JWT_EXPIRES_IN=8h
PUBLIC_API_URL=https://STAGING_PUBLIC_HOST/cotizador-staging
QUOTE_DOCUMENT_SIGNING_SECRET=replace-with-staging-signing-secret
STAGING_SEED_PASSWORD=replace-with-initial-test-user-password

# Private Docker URLs and STAGING_MODE are supplied by Compose.
STAGING_ERP_BUILD_CONTEXT=../../tuvansa-backend-ca
STAGING_ERP_ENV_FILE=../../tuvansa-backend-ca/.env.staging
STAGING_SAT_CATALOG_FILE=./catalogs/sat.xlsx
ERP_INTERNAL_API_KEY=replace-with-staging-erp-internal-key
ERP_PRODUCTS_BASE_PATH=/api/erp/products
ERP_SUPPLIERS_BASE_PATH=/api/erp/suppliers
ERP_API_TIMEOUT_MS=15000
AI_PLATFORM_INTERNAL_API_KEY=replace-with-staging-ai-internal-key
GPT_LOCAL_PRODUCTS_API_KEY=replace-with-staging-ai-internal-key
WHATSAPP_ASSISTANT_INTERNAL_API_KEY=replace-with-staging-assistant-key
AI_PLATFORM_TIMEOUT_MS=75000
AI_PLATFORM_MAX_UPLOAD_MB=15
GPT_LOCAL_PRODUCTS_TIMEOUT_MS=45000
LOCAL_PRODUCT_SEMANTIC_MIN_SCORE=0.72
FILE_UPLOAD_MAX_MB=20

# Feature defaults; administrative overrides live only in staging's database.
QUOTE_INTERNAL_APPROVAL_ENABLED=false
REQUISITION_INTERNAL_APPROVAL_ENABLED=false
SELLER_EXCEL_IMPORT_ENABLED=true

# Connect the DEVELOPMENT sender only; configure its webhook last.
STAGING_TWILIO_ALLOWED_RECIPIENTS=
STAGING_TWILIO_WHATSAPP_FROM=
STAGING_TWILIO_WHATSAPP_QUOTE_CONTENT_SID=
STAGING_TWILIO_WHATSAPP_MANAGER_REPORT_CONTENT_SID=
STAGING_TWILIO_WHATSAPP_INTERNAL_ALERT_CONTENT_SID=
TWILIO_WHATSAPP_MANAGER_REPORT_MEDIA_VARIABLE=7
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_WHATSAPP_ENABLED=false
WHATSAPP_INBOX_ENABLED=false
WHATSAPP_ASSISTANT_ENABLED=false
WHATSAPP_INTERNAL_VERIFICATION_ENABLED=false
STAGING_MANAGER_REPORT_SCHEDULER_ENABLED=false
MANAGER_REPORT_SCHEDULER_POLL_INTERVAL_MS=30000

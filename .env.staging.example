# Copy to .env.staging on the staging host. Never copy production credentials wholesale.
NODE_ENV=production
STAGING_DATABASE_URL=postgresql://STAGING_USER:STAGING_PASSWORD@STAGING_NEON_HOST/neondb?sslmode=require
JWT_SEED=replace-with-a-staging-only-random-secret
JWT_EXPIRES_IN=8h
PUBLIC_API_URL=https://STAGING_PUBLIC_HOST/cotizador-staging
QUOTE_DOCUMENT_SIGNING_SECRET=replace-with-a-different-staging-only-random-secret
SEED_ADMIN_PASSWORD=

# Read-only ERP lookups may use the existing ERP API once explicitly approved.
ERP_API_URL=
ERP_INTERNAL_API_KEY=
AI_PLATFORM_INTERNAL_API_KEY=replace-with-ai-internal-key-from-ai-staging-env
GPT_LOCAL_PRODUCTS_API_KEY=replace-with-ai-internal-key-from-ai-staging-env
WHATSAPP_ASSISTANT_INTERNAL_API_KEY=replace-with-shared-staging-assistant-key

# Compose forces STAGING_MODE. Leave the dedicated sender and templates empty until provisioned.
STAGING_TWILIO_ALLOWED_RECIPIENTS=+525500000000
STAGING_TWILIO_WHATSAPP_FROM=
STAGING_TWILIO_WHATSAPP_QUOTE_CONTENT_SID=
STAGING_TWILIO_WHATSAPP_MANAGER_REPORT_CONTENT_SID=
STAGING_TWILIO_WHATSAPP_INTERNAL_ALERT_CONTENT_SID=
TWILIO_WHATSAPP_MANAGER_REPORT_MEDIA_VARIABLE=7
TWILIO_WHATSAPP_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
WHATSAPP_INBOX_ENABLED=false
WHATSAPP_ASSISTANT_ENABLED=false
WHATSAPP_INTERNAL_VERIFICATION_ENABLED=false
